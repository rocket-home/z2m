# =========================================
# AUTO-GENERATED FILE — DO NOT EDIT MANUALLY
# =========================================
# This `zigbee2mqtt.yaml` was generated from `.env` using:
# - template: `z2m_manager/templates/zigbee2mqtt.yaml.j2`
# - command: `./z2m gen-configs --force`
#
# To change settings:
# - edit `.env` (and/or the template), then re-generate the config
# - for manual reference see `zigbee2mqtt.yaml.example`
homeassistant: false
permit_join: true

mqtt:
  base_topic: {{ MQTT_BASE_TOPIC | default("zigbee2mqtt") }}
  server: {{ MQTT_SERVER | default("mqtt://mqtt:1883") }}
{% if MQTT_USER %}
  user: "{{ MQTT_USER }}"
{% endif %}
{% if MQTT_PASSWORD %}
  password: "{{ MQTT_PASSWORD }}"
{% endif %}

serial:
  # В docker-compose устройство пробрасывается внутрь контейнера в ZIGBEE_DEVICE (по умолчанию /dev/zigbee)
  port: {{ ZIGBEE_DEVICE | default("/dev/zigbee") }}

frontend:
  port: {{ FRONTEND_PORT | default(4000) }}
  host: {{ FRONTEND_HOST | default("0.0.0.0") }}

# Reduce MQTT noise
advanced:
  log_level: warn
  log_namespaced_levels:
    z2m:mqtt: warning
  # ISO timestamp of the last Zigbee message per device (offline diagnostics).
  last_seen: ISO_8601

# Track reachability -> publish zigbee2mqtt/<device>/availability (online/offline).
# active = mains-powered (actively pinged), passive = battery (long timeout, minutes).
# Tune timeouts if you see false "offline" for rarely-reporting devices.
availability:
  active:
    timeout: 10
  passive:
    timeout: 1500

{% if DEVICES_YAML %}
devices:
{{ DEVICES_YAML | indent(2, true) }}
{% endif %}


