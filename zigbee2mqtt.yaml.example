# Minimal Zigbee2MQTT config template (copy to zigbee2mqtt.yaml for local use)
homeassistant: false

permit_join: true

mqtt:
  base_topic: zigbee2mqtt
  server: "mqtt://mqtt:1883"

serial:
  # В контейнере по умолчанию есть стабильное имя /dev/zigbee (см. docker-compose.yml)
  port: /dev/zigbee

# Frontend (web interface)
frontend:
  port: 4000
  host: 0.0.0.0

advanced:
  log_level: warn
  log_namespaced_levels:
    z2m:mqtt: warning
  # ISO timestamp of last Zigbee message per device (offline diagnostics).
  last_seen: ISO_8601

# Publish zigbee2mqtt/<device>/availability (online/offline). active = mains, passive = battery.
availability:
  active:
    timeout: 10
  passive:
    timeout: 1500



