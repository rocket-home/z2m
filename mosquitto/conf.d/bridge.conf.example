#connection rocket
# Порт 8883 + bridge_capath — обязательны: по открытому 1883 облако помечает хаб
# незащищённым и запрещает локальное исполнение автоматизаций.
#address mq.rocket-home.ru:8883
#bridge_capath /etc/ssl/certs
#bridge_protocol_version mqttv311
#try_private false
#topic # both 2
#remote_username XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
#remote_password XXXXXXXXXX
#notifications false



